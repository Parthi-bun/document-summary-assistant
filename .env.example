# Copy this file to `.env` and fill in a real key. `.env` is git-ignored.
# Never commit a real API key.

# ---- Required ----------------------------------------------------------------
# API key for any OpenAI-compatible chat-completions provider.
# The app returns an explicit configuration error (and never a fabricated
# summary) while this is unset.
LLM_API_KEY=

# ---- Optional ----------------------------------------------------------------
# Base URL of the provider, without a trailing /chat/completions.
# Default: https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Model id. Must support JSON output. Default: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# How long to wait for the provider before giving up, in milliseconds.
# Default: 90000
# LLM_TIMEOUT_MS=90000

# Port for the Express server. Default: 3001
# PORT=3001

# ---- Provider presets --------------------------------------------------------
# Uncomment ONE block. Only LLM_API_KEY is secret; the other two are not.
#
# Groq — free tier, fast, works in a cloud deployment. Key: https://console.groq.com/keys
# LLM_API_KEY=gsk_your_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# Google Gemini — free tier. Key: https://aistudio.google.com/apikey
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
#
# OpenAI — paid. Key: https://platform.openai.com/api-keys
# LLM_API_KEY=sk-your_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Ollama — free, fully local, LOCAL DEVELOPMENT ONLY. A deployed app cannot
# reach a model running on your laptop. Install: brew install --cask ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
